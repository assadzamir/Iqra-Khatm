# Copy to .env and fill in from your Supabase project settings (Project → API).
# EXPO_PUBLIC_* vars are embedded in the client bundle — anon key only, never
# the service-role key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Edge-function secrets are NOT set here — they live in Supabase:
#   supabase secrets set RESEND_API_KEY=re_...
# (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET are provided
# to edge functions automatically by the platform.)
